# Add the matching Singapore-region Model Studio key only to .env or Railway Variables.
# Never put a real key in this example file, public/, a screenshot, or chat.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
# Background observations, location events and diaries. Defaults: 200/day, 60/minute.
QWEN_MAX_DAILY_REQUESTS=
QWEN_MAX_REQUESTS_PER_MINUTE=
# Rider conversations (ASR, replies and TTS). Blank means no local call-count cap.
# A whole number sets a process-wide budget for rider requests. Zero disables calls.
QWEN_CONVERSATION_MAX_DAILY_REQUESTS=
QWEN_CONVERSATION_MAX_REQUESTS_PER_MINUTE=
# Recognition, replies and synthesis can run concurrently.
QWEN_MAX_CONCURRENT_REQUESTS=8

# Fast short voice replies; text and vision keep their own models.
QWEN_VOICE_MODEL=qwen-flash

# Live transcripts default to Flash Message for English and Flash Streaming for Korean, Chinese and Auto.
# Set a model globally, or override English separately.
# QWEN_ASR_REALTIME_MODEL=qwen-audio-3.1-asr-flash-streaming
# QWEN_ASR_REALTIME_MODEL_EN=qwen-audio-3.1-asr-flash-message
QWEN_REALTIME_ASR=on
# Optional streaming provider for selected English, Korean and Mandarin on current clients. Auto uses Qwen.
# VELO_ASR_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=

# Optional durable bicycle-memory database path. Default: Railway volume /data/velo-memory/memories.sqlite
# SOUL_MEMORY_DB=/data/velo-memory/memories.sqlite
