# Add the matching Singapore-region Model Studio key only to .env or Railway Variables.
# Never put a real key in this example file, public/, a screenshot, or chat.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
# Shared request count across visitors, per UTC day and per server process.
# This is not an Alibaba billing cap; enable Free Quota Only in its console if needed.
QWEN_MAX_DAILY_REQUESTS=200

# Fast short voice replies; text and vision keep their own models.
QWEN_VOICE_MODEL=qwen-flash

# Incremental live transcripts; the HTTP ASR model remains an outage fallback.
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
QWEN_REALTIME_ASR=on

# Optional durable bicycle-memory database path. Default: Railway volume /data/velo-memory/memories.sqlite
# SOUL_MEMORY_DB=/data/velo-memory/memories.sqlite
