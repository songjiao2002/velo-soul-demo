# Add the matching Singapore-region Model Studio key only to .env or Railway Variables.
# Never put a real key in this example file, public/, a screenshot, or chat.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
# Shared request count across visitors, per UTC day and per server process.
# This is not an Alibaba billing cap; enable Free Quota Only in its console if needed.
QWEN_MAX_DAILY_REQUESTS=200
